# xieyin 生命周期：卸载时停服务、移除 systemd 单元，保留 data/（配置与日志）。
set -u
PAYLOAD="$("$(cd "$(dirname "$0")" && pwd)/_common" 2>/dev/null || true)"
if [ -n "${PAYLOAD:-}" ] && [ -x "$PAYLOAD/pkg_uninstall.sh" ]; then
    bash "$PAYLOAD/pkg_uninstall.sh" && exit 0
fi
if [ -x /usr/local/xieyin/pkg_uninstall.sh ]; then
    bash /usr/local/xieyin/pkg_uninstall.sh
fi
exit 0
