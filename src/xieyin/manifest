appname               = xieyin
version               = 1.3.0
display_name          = 撷引
desc                  = 撷引（xieyin）· 飞牛 fnOS 媒体元数据刮削工具：番号 AV（JavBus）、电影（TMDB）、媒体体检与共享清理。网页里选目录、点按钮即可运行，日志实时查看。纯 Python 标准库实现，不依赖 Docker。清理默认开启 PT 保护：检测到 @GROUP 做种文件或 *.torrent 会直接拒绝执行，绝不改名、删除；刮削也只新增 nfo/图片，不改视频文件名。
platform              = x86
source                = thirdparty
maintainer            = xieyin
distributor           = xieyin
os_min_version        = 1.2.0
desktop_uidir         = ui
desktop_applaunchname = xieyin.Application
ctl_stop              = true
checkport             = true
service_port          = 22668
changelog             = 1.3.0：支持 STRM 刮削（Kodi/Jellyfin 流指针）——番号/电影/自动刮削、体检都认 .strm；清理对 .strm 无条件不删不改名；.strm 自动跳过 ffprobe。1.2.0：自动刮削（定时扫描 + qBittorrent）。1.1.0：ARM 架构。1.0.0：首个公开版本。
